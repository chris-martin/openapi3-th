cabal-version: 3.0
name:          openapi3-th
version:       0
data-files:    examples/**/*.yaml

common base
  ghc-options:        -fconstraint-solver-iterations=5
  default-language:   GHC2021
  default-extensions:
    AllowAmbiguousTypes
    ApplicativeDo
    BlockArguments
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    MultiWayIf
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    PartialTypeSignatures
    QuasiQuotes
    StrictData
    TemplateHaskell
    TypeFamilies
    UndecidableInstances
    UnicodeSyntax

library
  import:          base
  build-depends:
    , aeson
    , base
    , base64
    , bytestring
    , conduit
    , containers
    , filepath
    , generic-arbitrary
    , hspec
    , http-client
    , http-conduit
    , http-types
    , list-transformer
    , megaparsec
    , monad-validate
    , mtl
    , nonempty-containers
    , optics
    , quaalude
    , QuickCheck
    , template-haskell
    , text
    , transformers
    , vector
    , wai
    , warp
    , word8
    , yaml
    , yield

  hs-source-dirs:  library

  -- cabal-fmt: expand library
  exposed-modules:
    Oath
    Oath.Abnf.Rfc2234
    Oath.BasicAuth.Rfc7617
    Oath.Declare.Declare
    Oath.Declare.Options
    Oath.Grammar
    Oath.JsonPointer.Rfc6901
    Oath.OpenApi
    Oath.OpenApi.DataType
    Oath.OpenApi.ReadSpecFile
    Oath.OpenApi.Schema
    Oath.Operation.HttpClient
    Oath.Operation.IncomingRequest
    Oath.Operation.IncomingResponse
    Oath.Operation.Message
    Oath.Operation.Operation
    Oath.Operation.OutgoingRequest
    Oath.Operation.OutgoingResponse
    Oath.Operation.Testing
    Oath.Operation.Wai
    Oath.Relation
    Oath.Uri.Rfc3986.Grammar
    Oath.Uri.Rfc3986.Grammar.Appendages
    Oath.Uri.Rfc3986.Grammar.Authority
    Oath.Uri.Rfc3986.Grammar.Characters
    Oath.Uri.Rfc3986.Grammar.Host
    Oath.Uri.Rfc3986.Grammar.Path
    Oath.Uri.Rfc3986.Grammar.RelativeRef
    Oath.Uri.Rfc3986.Grammar.Scheme
    Oath.Uri.Rfc3986.Grammar.Segment
    Oath.Uri.Rfc3986.RelativeResolution
    Oath.Web.JsonReference
    Oath.Web.ResourceLocation

test-suite test
  import:         base
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test examples properties
  build-depends:
    , base
    , bytestring
    , containers
    , hspec
    , http-conduit
    , list-transformer
    , openapi3-th
    , optics
    , quaalude
    , QuickCheck
    , template-haskell
    , text
    , warp

  -- cabal-fmt: expand examples
  other-modules:
    OpenApiGuide.BasicStructure.Main
    OpenApiGuide.MediaTypes.Main
    OpenApiGuide.ServerUrlFormat

  -- cabal-fmt: expand properties
  other-modules:  Properties.ResourceLocation.Monoid
